    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/uuid": "^9.0.2",
    "nodemon": "^3.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.1.3"
  }
