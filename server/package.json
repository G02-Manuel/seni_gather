{
  "name": "@orbitra/server",
  "version": "0.1.0",
  "description": "Backend de Orbitra con Socket.io y WebRTC signaling",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec \"tsx src/index.ts\"",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
